# =========================================================
# Stage 1: Builder
# =========================================================
FROM artifactory.globaldevtools.bbva.com:443/public.ecr.aws-remote/docker/library/python:3.14-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

RUN python -m pip install --no-cache-dir uv

COPY pyproject.toml uv.lock README.md ./

# uv detecta automáticamente el archivo ~/.netrc montado en el contexto de Kaniko
# (pipeline real de build) — no se pasan credenciales de Artifactory por build-arg.
RUN uv sync --frozen --no-dev --no-install-project

# =========================================================
# Stage 2: Runtime
# =========================================================
FROM artifactory.globaldevtools.bbva.com:443/public.ecr.aws-remote/docker/library/python:3.14-slim AS runtime

ARG GENAI_ENVIRONMENT=production

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    GENAI_ENVIRONMENT=${GENAI_ENVIRONMENT} \
    PATH="/app/.venv/bin:$PATH"

# Crear usuario sin privilegios
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /sbin/nologin -d /app appuser

WORKDIR /app

# Copiar artefactos compilados desde la etapa de build
COPY --from=builder --chown=appuser:appgroup /app/.venv /app/.venv
COPY --chown=appuser:appgroup src ./src

# Reducir permisos
RUN chmod -R 555 /app

USER appuser

EXPOSE 8081

CMD ["uvicorn", "--app-dir", "src", "app.api.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8081", \
     "--no-server-header", \
     "--proxy-headers"]
