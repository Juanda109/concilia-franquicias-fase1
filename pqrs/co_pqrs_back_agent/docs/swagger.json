{
  "openapi": "3.1.0",
  "info": {
    "title": "agentepqr API",
    "description": "Base API for health checks and chat message intake.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health check",
        "description": "Return the API availability status.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthcheckResponse"
                }
              }
            }
          }
        }
      }
    },
    "/start": {
      "post": {
        "tags": [
          "start"
        ],
        "summary": "Start a conversation",
        "description": "Create a conversation and return the configured assistant greeting.",
        "operationId": "start_conversation_start_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Conversation created and greeting returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict: an active session already exists for this user, or the user reached the daily session limit (MAX_DAILY_SESSIONS, default 3). Example message: \"Has alcanzado el límite de 3 sesiones diarias.\""
          },
          "406": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Receive a chat message",
        "description": "Receive a chat payload, persist workflow context, and return the next prompt.",
        "operationId": "receive_chat_message_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Message processed or still running \u2014 body always present. Check `status` field: \"Running\" means the turn is still in progress.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "406": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/polling": {
      "post": {
        "tags": [
          "polling"
        ],
        "summary": "Check whether an async chat turn has finished",
        "description": "Check whether the latest async chat turn has finished processing.",
        "operationId": "poll_conversation_status_polling_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PollingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Conversation is still processing \u2014 keep polling.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PollingResponse"
                }
              }
            }
          },
          "303": {
            "description": "Turn finished \u2014 follow Location header to GET /polling/{conversation_id}. Response body is empty."
          },
          "406": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/polling/{conversation_id}": {
      "get": {
        "tags": [
          "polling"
        ],
        "summary": "Get the latest bot message for a conversation",
        "description": "Return the latest assistant message once polling indicates completion.",
        "operationId": "get_polling_message_polling__conversation_id__get",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Conversation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest bot message. Returned whether the turn is still running or already finished \u2014 check `status` field.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "406": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/end": {
      "post": {
        "tags": [
          "end"
        ],
        "summary": "End a conversation",
        "description": "Finaliza formalmente la conversación, cierra el flujo de trabajo activo \ny persiste el estado final.",
        "operationId": "end_conversation_end_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EndRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Conversation ended successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EndResponse"
                }
              }
            }
          },
          "406": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatMessageContent": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label",
            "description": "General question or message shown above the options.",
            "examples": [
              "Hola, en que te puedo ayudar?"
            ]
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageOption"
            },
            "type": "array",
            "title": "Options",
            "description": "Selectable options associated with the message, when applicable."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label"
        ],
        "title": "ChatMessageContent",
        "description": "Structured assistant content rendered by the frontend for `POST /chat`."
      },
      "ChatMessageEnvelope": {
        "properties": {
          "sender": {
            "type": "string",
            "const": "bot",
            "title": "Sender",
            "description": "Sender identifier expected by the frontend.",
            "examples": [
              "bot"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "UTC timestamp associated with the assistant response."
          },
          "input_type": {
            "type": "string",
            "enum": [
              "choice",
              "text",
              "terminal"
            ],
            "title": "Input Type",
            "description": "Type of input the frontend should expect after rendering the message.",
            "examples": [
              "choice"
            ]
          },
          "content": {
            "$ref": "#/components/schemas/ChatMessageContent",
            "description": "Structured chat content rendered by the chat frontend."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sender",
          "timestamp",
          "input_type",
          "content"
        ],
        "title": "ChatMessageEnvelope",
        "description": "Assistant message metadata plus structured chat content."
      },
      "ChatMessageOption": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key",
            "description": "Stable option key sent back by the frontend when the user selects it.",
            "examples": [
              "centrales_de_riesgo"
            ]
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "User-facing option label rendered by the frontend.",
            "examples": [
              "Centrales de riesgo"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "label"
        ],
        "title": "ChatMessageOption",
        "description": "Selectable option rendered by the frontend."
      },
      "ChatRequest": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "pattern": "^\\d+_\\d{8}$",
            "title": "Conversation Id",
            "description": "Conversation identifier formatted as customer_id_yyyymmdd.",
            "examples": [
              "03966512_20260421"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "title": "Content",
            "description": "User message content to be processed by the API.",
            "examples": [
              "Hola, necesito ayuda con mi solicitud."
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation_id",
          "content"
        ],
        "title": "ChatRequest",
        "description": "Request payload for posting a user conversation message."
      },
      "ChatResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current lifecycle status of the conversation after processing the request.",
            "examples": [
              "Active"
            ]
          },
          "conversation_id": {
            "type": "string",
            "pattern": "^\\d+_\\d{8}$",
            "title": "Conversation Id",
            "description": "Conversation identifier associated with the processed request.",
            "examples": [
              "03966512_20260421"
            ]
          },
          "message": {
            "$ref": "#/components/schemas/ChatMessageEnvelope",
            "description": "Structured assistant response returned by the API."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "conversation_id",
          "message"
        ],
        "title": "ChatResponse",
        "description": "Response payload for conversation message endpoints."
      },
      "EndRequest": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "pattern": "^\\d+_\\d{8}$",
            "title": "Conversation Id",
            "description": "Conversation identifier formatted as customer_id_yyyymmdd.",
            "examples": [
              "03966512_20260421"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation_id"
        ],
        "title": "EndRequest",
        "description": "Request payload for ending an existing conversation."
      },
      "EndResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current lifecycle status of the conversation after processing the request.",
            "examples": [
              "Active"
            ]
          },
          "conversation_id": {
            "type": "string",
            "pattern": "^\\d+_\\d{8}$",
            "title": "Conversation Id",
            "description": "Conversation identifier associated with the processed request.",
            "examples": [
              "03966512_20260421"
            ]
          },
          "message": {
            "$ref": "#/components/schemas/ChatMessageEnvelope",
            "description": "Structured assistant response returned by the API."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "conversation_id",
          "message"
        ],
        "title": "EndResponse",
        "description": "Response payload for ending an existing conversation."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthcheckResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthcheckResponse"
      },
      "PollingData": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current processing status of the conversation.",
            "examples": [
              "running"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "PollingData",
        "description": "Payload nested inside a polling status response."
      },
      "PollingResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PollingData",
            "description": "Polling status data."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data"
        ],
        "title": "PollingResponse",
        "description": "Response payload for POST /polling when the conversation is still processing."
      },
      "PollingRequest": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "pattern": "^\\d+_\\d{8}$",
            "title": "Conversation Id",
            "description": "Conversation identifier formatted as customer_id_yyyymmdd.",
            "examples": [
              "03966512_20260421"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation_id"
        ],
        "title": "PollingRequest",
        "description": "Request payload for checking whether an async chat turn has finished."
      },
      "StartMessageContent": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label",
            "description": "General question or message shown above the options.",
            "examples": [
              "Hola, en que te puedo ayudar?"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "label"
        ],
        "title": "StartMessageContent",
        "description": "Structured assistant content rendered by the frontend for `POST /start`."
      },
      "StartMessageEnvelope": {
        "properties": {
          "sender": {
            "type": "string",
            "const": "bot",
            "title": "Sender",
            "description": "Sender identifier expected by the frontend.",
            "examples": [
              "bot"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "UTC timestamp associated with the assistant response."
          },
          "input_type": {
            "type": "string",
            "enum": [
              "choice",
              "text",
              "terminal"
            ],
            "title": "Input Type",
            "description": "Type of input the frontend should expect after rendering the message.",
            "examples": [
              "text"
            ]
          },
          "content": {
            "$ref": "#/components/schemas/StartMessageContent",
            "description": "Structured start content rendered by the chat frontend."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sender",
          "timestamp",
          "input_type",
          "content"
        ],
        "title": "StartMessageEnvelope",
        "description": "Assistant message metadata plus structured start content."
      },
      "StartRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\d+$",
            "title": "User Id",
            "description": "Unique user identifier used to generate the conversation_id as `user_id_yyyymmdd`.",
            "examples": [
              "03966512"
            ]
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content",
            "description": "Optional initial text. `POST /start` ignores this field and returns the configured greeting; send the first real request to `POST /chat`.",
            "examples": [
              "Hola, necesito ayuda con mi solicitud."
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "StartRequest",
        "description": "Request payload for starting a new conversation."
      },
      "StartResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current lifecycle status of the conversation after processing the request.",
            "examples": [
              "Active"
            ]
          },
          "conversation_id": {
            "type": "string",
            "pattern": "^\\d+_\\d{8}$",
            "title": "Conversation Id",
            "description": "Conversation identifier associated with the processed request.",
            "examples": [
              "03966512_20260421"
            ]
          },
          "message": {
            "$ref": "#/components/schemas/StartMessageEnvelope",
            "description": "Structured assistant greeting returned by the API."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "conversation_id",
          "message"
        ],
        "title": "StartResponse",
        "description": "Response payload for the start endpoint."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
