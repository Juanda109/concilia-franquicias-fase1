# Base environment configuration (plantilla; reemplaza los valores reales)
BOT_NAME=blue
END_CONVERSATION_CALLBACK_URL=http://127.0.0.1:8001/end/{conversation_id}

# Limite de sesiones que un usuario puede iniciar por dia calendario.
MAX_DAILY_SESSIONS=3
# Interacciones permitidas por categoria de limite (centrales / general) y dia.
# Tope de interacciones por caso y por dia. Subido a 100 para pruebas; el
# valor de negocio es 3.
MAX_DAILY_CATEGORY_INTERACTIONS=100
# Maximo de re-chequeos (advertencias de consulta repetida) por cliente y dia.
MAX_REPEAT_RECHECKS=3

# Credenciales del modelo (NO subir secretos reales al repositorio)
API_KEY=changeme
ENDPOINT=https://your-llm-endpoint.openai.azure.com/
LLM_MODEL=agentepqrs-llm-live-agent-gpt54mini
LLM_EMBEDDINGS=agentepqrs-llm-live-emebed-3-large
SSL_VERIFY=false

# OpenSearch
OPENSEARCH_ENDPOINT=https://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_VERIFY_SSL=false
OPENSEARCH_CONVERSATIONS_INDEX=conversations-reference
OPENSEARCH_MESSAGES_INDEX=conversations-messages
OPENSEARCH_TIMEOUT=10

# Servicio de datos
BACK_DATA_SERVICE_URL=http://localhost:8003
# Servicio de Transaccion No Reconocida (co_pqrs_back_trx_noreconocida).
TRX_SERVICE_URL=http://localhost:8004
# Interruptor del flujo TXNR. Por defecto es false y desvia TODO el flujo al
# formulario PQR (paso 2.4.0.4.pqr).
TRX_FLOW_ENABLED=true
# Recurrencia-bot: por defecto 1, asi que a la SEGUNDA prueba con el mismo
# cliente el bot desvia al formulario. Se sube para poder repetir pruebas.
MAX_TRX_BOT_RECURRENCE=3
TRX_RECURRENCIA_MESES=6

# Servicio de Doble Cobro (co_pqrs_back_doble_cobro).
DC_SERVICE_URL=http://localhost:8006
# Transacciones por pagina en el selector de doble cobro (paso 3.4.0.6).
# Tope: 10, que son las casillas declaradas en doble_cobro.yml.
TRANSACTIONS_PER_PAGE=6

# Servicio de auditoria de errores (push fire-and-forget; opcional)
ERROR_HANDLER_SERVICE_URL=http://localhost:8002
# Status HTTP minimo que se audita (400 = todos los errores; 500 = solo servidor)
AUDIT_MIN_STATUS=400

# RabbitMQ (publicacion de eventos para el tablero en tiempo real; gated)
# Inerte mientras RABBITMQ_ENABLED=false. Enciendelo cuando RabbitMQ este arriba.
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_EXCHANGE=pqr.events
RABBITMQ_EXCHANGE_TYPE=topic

# Guardrails
# Activa el juez semantico de alcance (Fase 3). true para encenderlo.
GUARDRAIL_JUDGE_ENABLED=true

# CORS (opcional)
# CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# CORS_ALLOW_METHODS=*
# CORS_ALLOW_HEADERS=*
# CORS_ALLOW_CREDENTIALS=false
