# co_pqrs_back_trx_noreconocida (MOCK) — variables de entorno de ejemplo.
# Copiar a .env para desarrollo local. NO commitear el .env real.

# Puerto del servicio (local).
TRX_SERVICE_PORT=8004

# Nivel de log.
TRX_LOG_LEVEL=INFO

# Consulta de productos activos en la tabla ADA de Postgres.
# Selector de fuente para productos (postgres/mock).
# TRX_PRODUCTS_SOURCE=fo  (defecto: el financial-overview es la UNICA fuente de productos)
# TRX_PRODUCTS_SOURCE=postgres  -> DEPRECADO (via de escape; se retira en H5)
# Compatibilidad: también se respeta CUSTOMER_IDENTITY_SOURCE.
# CUSTOMER_IDENTITY_SOURCE=postgres
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASS=
# TRX_POSTGRES_TABLE=ada_info_detail
# POSTGRES_CONNECT_TIMEOUT=5

# Selector de fuente Salesforce. Se usa como llamado ASO en modo mock.
# TRX_SALESFORCE_SOURCE=mock

# --- Futuras integraciones (aún no usadas; el servicio es MOCK) ---
# URL(es) de los ASOS a consumir cuando dejemos de mockear.
# ASO_BASE_URL=
# Fuente de datos transaccionales del cliente.
# TRX_DATA_SOURCE=

# Politica IT4.6: maximo 3 solicitudes por tipologia en una ventana de 6 meses.
MAX_TRX_BOT_RECURRENCE=3
TRX_RECURRENCIA_MESES=6
