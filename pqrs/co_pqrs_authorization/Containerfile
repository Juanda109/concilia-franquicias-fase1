FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir \
    "fastapi>=0.115" "uvicorn>=0.30" "httpx>=0.27" "pydantic>=2.7"
COPY src /app/src
ENV PYTHONPATH=/app/src
EXPOSE 8005
CMD ["uvicorn", "--app-dir", "src", "infrastructure.entrypoint.fastapi_app:app", "--host", "0.0.0.0", "--port", "8005"]
