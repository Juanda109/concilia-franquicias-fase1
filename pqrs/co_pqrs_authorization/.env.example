# --- servicio ---
AUTHORIZATION_SERVICE_PORT=8005
AUTHORIZATION_DEADLINE_SECONDS=180

# --- worker ---
AUTHORIZATION_WORKER_ENABLED=true
AUTHORIZATION_WORKER_TICK=5
AUTHORIZATION_RETRY_SECONDS=10
AUTHORIZATION_LEASE_SECONDS=30
AUTHORIZATION_WORKER_BATCH=20

# --- persistencia (OpenSearch operativo) ---
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=admin
AUTHORIZATIONS_INDEX=authorizations
OPENSEARCH_VERIFY_SSL=false

# --- ASO (solo granting + order-chanel; el push NO vive aqui) ---
# simulator (local) | real (QA/PRD) — URLs por entorno, jamas hardcodeadas
ASO_SOURCE=simulator
ASO_SIMULATOR_URL=http://localhost:8050
ASO_REAL_URL=
ASO_CHALLENGE_BASE_URL=
TRX_API_USER_ID=
TRX_API_CONSUMER_ID=12000035
TRX_API_AUTHENTICATION_TYPE=04
TRX_API_PASSWORD=

# --- trazas MinIO (via error_handler); vacio = desactivadas ---
ERROR_HANDLER_SERVICE_URL=
