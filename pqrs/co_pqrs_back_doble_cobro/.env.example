# Configuracion del servicio co_pqrs_back_doble_cobro (:8006).

DOBLE_COBRO_LOG_LEVEL=INFO

# ===== ASO =====
# Switch de origen: "simulator" usa DC_ASO_SIMULATOR_URL; "real" usa DC_ASO_REAL_URL.
ASO_SOURCE=simulator
DC_ASO_SIMULATOR_URL=http://127.0.0.1:8050
DC_ASO_REAL_URL=https://dev-arqaso.work.co.nextgen.igrupobbva:8050

# OJO: DC_ASO_BASE_URL es un override MANUAL y gana sobre ASO_SOURCE. Si esta
# definida, poner ASO_SOURCE=real no cambia nada y las peticiones siguen yendo
# a donde apunte esta linea. Comentala antes de probar contra el ASO real.
DC_ASO_BASE_URL=http://127.0.0.1:8050

DC_ASO_FO_PATH=/financial-overview/v0/financial-overview
DC_ASO_OPERATIONS_PATH=/cards/v2/operations

# --- Credenciales del grantingTicket (el simulador las ignora) ---
# Con DC_ASO_TICKET_URL vacio se usa {base}/TechArchitecture/co/grantingTicket/V02.
DC_ASO_TICKET_URL=
DC_ASO_API_USER_ID=ZM12035
DC_ASO_API_CONSUMER_ID=12000035
DC_ASO_API_AUTHENTICATION_TYPE=04
DC_ASO_API_PASSWORD=

# El ASO real presenta un certificado corporativo que la CA publica no firma:
# con la verificacion activa, el grantingTicket muere en el handshake, el TSEC
# queda vacio y las dos llamadas salen SIN autenticar (el ASO responde 401 y el
# flujo acaba en el formulario PQR como si el cliente no tuviera productos).
DC_ASO_API_VERIFY_SSL=false
DC_ASO_API_TIMEOUT=30

# El TSEC nunca se escribe completo en las trazas (KYNS IT 3). Se emite una
# huella (longitud, prefijo, sufijo y SHA256) que ya permite comparar tokens.

# ===== Reglas de negocio =====
# Ventana de conciliacion con el comercio antes de poder reclamar (dias habiles).
# Es la misma para cuentas y para tarjetas debito.
DC_SETTLEMENT_DAYS=7

# Vigencia para reportar: primero el plazo general, despues la franquicia.
DC_MAX_REPORT_MONTHS=6
DC_VISA_VALIDITY_DAYS=180
DC_MASTER_VALIDITY_DAYS=120

# Deteccion de duplicados.
# Margen alrededor del monto que escribe el cliente (solo para BUSCAR).
# Al agrupar el monto debe ser identico, ademas de mismo comercio y misma fecha.
DC_AMOUNT_TOLERANCE=2000
